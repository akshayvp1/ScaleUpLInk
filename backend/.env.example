# Server
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins. FRONTEND_URL and CORS_ORIGINS are also read.
CLIENT_URL=http://localhost:5173
# FRONTEND_URL=https://your-frontend.onrender.com
# CORS_ORIGINS=https://your-frontend.onrender.com,https://www.example.com

# Database
MONGO_URI=mongodb://127.0.0.1:27017/scaleup-link

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Google OAuth (GOOGLE_CLIENT_SECRET is not read by backend code)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis
# Prefer REDIS_URL in production (redis:// or rediss://).
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# OTP
# Registration, resend and password-reset OTPs all use this TTL (seconds).
OTP_TTL_SECONDS=600

# SMTP
# Leave SMTP_HOST empty to use the gmail service with SMTP_USER/SMTP_PASS.
# For other providers set SMTP_HOST, SMTP_PORT and SMTP_SECURE.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Stripe (STRIPE_PUBLISHABLE_KEY is not read by backend code)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
